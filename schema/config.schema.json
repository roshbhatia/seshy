      "properties": {
        "postCreate": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "postAdd": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preDelete": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
